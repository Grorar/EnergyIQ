# ─────────────────────────────────────────
# EnergyIQ 환경변수 설정 파일
# 이 파일을 복사해서 .env 로 이름을 바꾸고
# 각 항목에 실제 API 키를 입력하세요.
# .env 파일은 절대 GitHub에 올리지 마세요!
# ─────────────────────────────────────────

# 한국전력공사 빅데이터 오픈API
# 발급처: https://bigdata.kepco.co.kr
KEPCO_API_KEY=여기에_한전_API_키_입력

# Open-Meteo API (현재 미사용 — 필요 시 입력)
# 발급처: https://open-meteo.com
WEATHER_API_KEY=여기에_날씨_API_키_입력

# Grok AI API (xAI)
# 발급처: https://console.x.ai
GROK_API_KEY=여기에_Grok_API_키_입력

# 한국에너지공단 에너지소비효율 등급 API
# 발급처: https://www.data.go.kr (B553530)
ENERGY_GRADE_KEY=여기에_에너지공단_API_키_입력

# 서버 포트 (기본값: 3000)
# PORT=3000
